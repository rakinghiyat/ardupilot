  <ground_reactions>

    <!-- ================================================================= -->
    <!-- LAUNCH CRADLE / RAIL - KALIBRASI MENUJU 20 deg (iterasi 1)         -->
    <!-- Rail launcher dimodelkan sebagai ground contact: cara alami JSBSim -->
    <!-- menahan pesawat (stabil 6-DOF, tanpa gaya buatan).                 -->
    <!--                                                                    -->
    <!-- PENTING: sudut GEOMETRI != sudut TERUKUR. Kontak roda adalah       -->
    <!-- pegas (nose 1892 N/M, main 1594 N/M), tertekan beda di bawah       -->
    <!-- beban, jadi sikap istirahat lebih landai dari hitungan geometri.   -->
    <!-- Terukur di log sakti-jsbsim.csv (kolom attitude/pitch-deg,       -->
    <!-- saat V=0 sebelum katapel menembak):                                -->
    <!--     z=-0.871 -> geometri 34.59 deg -> TERUKUR 30.5 deg  (-4.09)    -->
    <!--                                                                    -->
    <!-- Iterasi 1 menuju 20 deg terukur: geometri 24.09 deg                -->
    <!--     dz = 1.06 * tan(24.09) = 0.474 -> z = -(0.14+0.474) = -0.614   -->
    <!-- CARA VERIFIKASI: jalankan SITL, buka sakti-jsbsim.csv, baca      -->
    <!-- pitch-deg pada baris terakhir sebelum catapult-lbs berubah dari 0. -->
    <!-- Kalau belum 20 deg, geser z sesuai selisihnya lalu ulangi.         -->
    <!-- Saat catapult menembak, pesawat meluncur & lepas dari cradle.      -->
    <!-- ================================================================= -->
    <contact type="BOGEY" name="NOSE">
      <location unit="M">
        <x>     0.34    </x>
        <y>     0.00    </y>
        <z>    -0.614   </z>
      </location>
      <static_friction>  0.80 </static_friction>
      <dynamic_friction> 0.50 </dynamic_friction>
      <rolling_friction> 0.02 </rolling_friction>
      <spring_coeff  unit="N/M">      1892.00  </spring_coeff>
      <damping_coeff unit="N/M/SEC">  293.00   </damping_coeff>
      <max_steer unit="DEG"> 0.00 </max_steer>
      <!-- CENTER (bukan NONE) supaya roda hidung ikut ditahan rem
           holdback di Systems/launcher.xml saat run-up di rel. -->
      <brake_group> CENTER </brake_group>
      <retractable> 0 </retractable>
    </contact>
