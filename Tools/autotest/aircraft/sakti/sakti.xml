  <flight_control name="FCS: sakti">

    <!-- ================================================================= -->
    <!-- LAUNCHER STATE PROPERTIES                                         -->
    <!-- Nilai di-latch oleh Systems/launcher.xml (bukan <event>, dan      -->
    <!-- bukan dari SIM_JSBSim.cpp - versi ini murni XML).                 -->
    <!--   launch-armed  : latch, 1 saat elevator nose-up penuh (ArduPilot -->
    <!--                   arm di AUTO takeoff)                            -->
    <!--   launch-done   : latch, 1 saat exit speed 35 m/s tercapai        -->
    <!--   launch-active : armed AND NOT done -> gate gaya catapult        -->
    <!-- ================================================================= -->
    <property value="0"> fcs/launch-armed    </property>
    <property value="0"> fcs/launch-done     </property>
    <property value="0"> fcs/launch-active   </property>

    <channel name="Throttle">
      <!-- ============================================================
           ENGINE RUN-UP PRA-LAUNCH
           Selama fcs/launch-runup = 1 (sudah di-arm tapi belum lepas
           rail), throttle dipaksa penuh supaya mesin mencapai daya
           launch sebelum catapult menembak - meniru prosedur run-up
           kru launcher. Di luar itu, throttle mengikuti ArduPilot.
           ArduPilot sendiri tidak bisa melakukan ini di mode AUTO
           (TKOFF_THR_IDLE terkunci catch-22, lihat Systems/launcher.xml).
           ============================================================ -->
      <switch name="fcs/throttle-pos-norm">
        <default value="fcs/throttle-cmd-norm"/>
        <test value="1.0">
          fcs/launch-runup gt 0.5
        </test>
      </switch>
    </channel>

  </flight_control>

