<?xml version="1.0"?>

<PropertyList>

    <!-- MAIN MODEL -->
    <path>sakti.ac</path>

    <!-- ================================================================= -->
    <!-- MODEL OFFSETS - penyelarasan mesh .ac terhadap titik FDM           -->
    <!--                                                                    -->
    <!-- Ini SATU-SATUNYA tempat FlightGear membaca <offsets> (sibling dari -->
    <!-- <path>). Bukan di sakti-set.xml, dan bukan VRP/AERORP/EYEPOINT   -->
    <!-- di sakti.xml (itu properti JSBSim, FG tidak membacanya).         -->
    <!--                                                                    -->
    <!-- MASALAHNYA: origin mesh sakti.ac ada di HIDUNG (X=0..2.1,       -->
    <!-- hidung=0, ekor=2.1). FG memutar model di titik origin. Saat pesawat -->
    <!-- pitch +30 deg nose-up di cradle, ekor terayun turun 2.1*sin30 =    -->
    <!-- 1.05 m, sementara origin cuma ~0.32 m di atas tanah => ekor        -->
    <!-- terbenam, hanya hidung nongol.                                     -->
    <!-- Bandingkan c172p: origin .ac-nya di tengah badan (X=-2.14..6.09),  -->
    <!-- makanya tidak butuh x-offset.                                      -->
    <!--                                                                    -->
    <!-- Sumbu .ac (sama utk sakti & c172p): X=memanjang(+ke ekor),         -->
    <!-- Y=ke atas, Z=bentang sayap.                                        -->
    <!--                                                                    -->
    <!-- TITIK AWAL TUNING: geser mesh ke depan sejauh CG (x=1.13567 di     -->
    <!-- sakti.xml) supaya CG jatuh di origin/pusat rotasi, seperti c172p.-->
    <!-- Kalau arah x-m ternyata terbalik, coba +1.136. Setelah x pas, baru -->
    <!-- setel y-m (naik/turun) supaya roda menyentuh landasan.             -->
    <!-- ================================================================= -->
    <offsets>
        <!-- <x-m>-1.136</x-m> -->
        <x-m>-1.8</x-m>
        <y-m>0.0</y-m>
        <z-m>0.0</z-m>
        <pitch-deg>0.0</pitch-deg>
        <roll-deg>0.0</roll-deg>
        <heading-deg>0.0</heading-deg>
    </offsets>

