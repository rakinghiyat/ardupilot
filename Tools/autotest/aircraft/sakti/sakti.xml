 <external_reactions>

    <!-- ================================================= -->
    <!-- LAUNCHER / CATAPULT SYSTEM                        -->
    <!-- Spesifikasi:                                      -->
    <!--   Massa (empty+payload+fuel) : ~60 kg            -->
    <!--   Sudut rail (nose up)       : 30 deg (cradle)   -->
    <!--   Exit speed (Vlo)           : 35 m/s (114.83 fps)-->
    <!--   Gaya konstan 875 lbf (~3892 N) =>               -->
    <!--     PANJANG RAIL ~10 m, stroke ~0.58 s, ~6.2 g    -->
    <!--   (rail = jarak tempuh selama catapult aktif;     -->
    <!--    diukur dgn integrasi kecepatan, bukan dimodel- -->
    <!--    kan sbg constraint fisik. Gaya lebih kecil =   -->
    <!--    rail lebih panjang: 1300 lbf ~= 6.5 m)         -->
    <!--                                                   -->
    <!-- Trigger: fcs/launch-active dari Systems/launcher.xml -->
    <!--   = launch-armed AND NOT launch-done              -->
    <!--   - Sebelum launch  : 0 -> gaya 0                 -->
    <!--   - Selama stroke   : 1 -> 875 lbf                -->
    <!--   - Setelah 35 m/s  : 0 -> gaya 0 (latch, tidak   -->
    <!--     re-fire saat pesawat sudah di udara)          -->
    <!-- ================================================= -->

    <force name="catapult" frame="BODY">
      <function name="forces/catapult-lbs">
        <product>
          <property>fcs/launch-active</property>
          <value> 875 </value>
        </product>
      </function>
      <location unit="M">
        <x> 1.10 </x>
        <y> 0.00 </y>
        <z> 0.00 </z>
      </location>
      <direction>
        <x> 1 </x>
        <y> 0 </y>
        <z> 0 </z>
      </direction>
    </force>

    <!-- ================================================= -->
    <!-- LAUNCH RAIL CONSTRAINT                            -->
    <!-- Redam gerak lateral selama pesawat masih di rail  -->
    <!-- (aktif hanya selama stroke: armed & belum done)   -->
    <!-- ================================================= -->

    <force name="rail_side" frame="BODY">
      <function name="forces/rail-side-lbs">
        <product>
          <property>fcs/launch-active</property>
          <value> -2.0 </value>
          <property>velocities/v-fps</property>
        </product>
      </function>
      <location unit="M">
        <x> 1.10 </x>
        <y> 0.00 </y>
        <z> 0.00 </z>
      </location>
      <direction>
        <x> 0 </x>
        <y> 1 </y>
        <z> 0 </z>
      </direction>
    </force>

  </external_reactions>

  <!-- rate = jumlah baris data per detik.
       Tanpa atribut ini JSBSim memakai default 1 data/detik - terlalu
       kasar untuk menganalisa launch (stroke catapult hanya ~0.55 detik).
       rate="10" = 10 data/detik (tiap 0.1 detik).
       Naikkan ke 50-200 kalau perlu melihat transien yang sangat cepat,
       tapi ukuran file ikut membengkak. -->
  <output name="sakti-jsbsim.csv" type="CSV" rate="100">

    <!-- DEBUG TRIM -->
    <property>fcs/antitorque-lo</property>
    <property>fcs/antitorque-ro</property>
    <property>fcs/aileron-cmd-norm</property>
    <property>propulsion/engine/propeller-torque-ftlb</property>

    <!-- LAUNCHER STATE (debug) -->
    <property>fcs/launch-cmd</property>
    <property>fcs/launch-runup</property>
    <property>fcs/elevator-cmd-norm</property>
    <property>fcs/launch-armed</property>
    <property>fcs/launch-done</property>
    <property>fcs/launch-active</property>
    <property>forces/catapult-lbs</property>


    <!-- SIMULATION TIME / FRAME -->
    <property>sim/sitl-frame-counter</property>

    <!-- PROPULSION -->
    <property>propulsion/engine[0]/engine-rpm</property>
    <property>propulsion/engine[0]/thrust-lbs</property>
    <property>fcs/throttle-cmd-norm</property>
    <property>fcs/throttle-pos-norm</property>
    <property>forces/fbx-prop-lbs</property>

    <!-- ENGINE STATUS -->
    <property>propulsion/starter_cmd</property>
    <property>propulsion/magneto_cmd</property>
    <property>fcs/mixture-cmd-norm</property>
    <property>fcs/mixture-pos-norm</property>
    <property>propulsion/engine[0]/AFR</property>

    <!-- BAHAN BAKAR
         fuel-flow-rate-pps = pound/detik. kg/jam = nilai x 1633.0
         contents-lbs       = isi tangki (pound). kg = nilai x 0.4536
         weight-lbs turun mengikuti bahan bakar yang terbakar, dan CG
         ikut bergeser karena tangki tidak berada di titik CG. -->
    <property>propulsion/engine[0]/fuel-flow-rate-pps</property>
    <property>propulsion/engine[0]/fuel-flow-rate-gph</property>
    <property>propulsion/engine[0]/power-hp</property>
